---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SeasonScene from '../components/SeasonScene.astro';

type Props = CollectionEntry<'blog'>['data'] & { centered?: boolean };

const { title, description, pubDate, updatedDate, heroImage, centered = false } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image {
				margin-bottom: 2em;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
			}
			.post-header {
				margin-bottom: 2.5em;
			}
			.post-header h1 {
				margin-bottom: 0.3em;
			}
			.date {
				margin: 0;
				color: var(--muted);
				font-size: 0.9em;
			}
			/* 简短页面（关于页）：正文面板在页头之下的可视区域内垂直居中 */
			body.center-stage {
				display: flex;
				flex-direction: column;
				min-height: 100vh;
				min-height: 100dvh;
			}
			body.center-stage main {
				flex: 1;
				display: flex;
				flex-direction: column;
			}
			/* 自动外边距吸收剩余空间；内容超长时自然退回顶部对齐 */
			body.center-stage article {
				margin-block: auto;
			}
		</style>
	</head>

	<body class={centered ? 'center-stage' : undefined}>
		<Header />
		<SeasonScene />
		<main>
			<article class="glass-panel">
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} quality={90} src={heroImage} alt="" />
						</div>
					)
				}
				<header class="post-header">
					<h1>{title}</h1>
					<p class="date">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span>
									{' '}
									· 更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</p>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
