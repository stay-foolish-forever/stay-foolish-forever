---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- 主题初始化：按时间自动切换白天（6:00-18:00）/ 黑夜；手动切换仅保持到下一个昼夜边界 -->
<script is:inline>
	(() => {
		localStorage.removeItem('theme'); // 清理旧版键
		const autoTheme = () => {
			const h = new Date().getHours();
			return h >= 6 && h < 18 ? 'light' : 'dark';
		};
		const apply = () => {
			// 调试：#day / #night 强制主题
			if (location.hash === '#day' || location.hash === '#night') {
				document.documentElement.dataset.theme = location.hash === '#day' ? 'light' : 'dark';
				return;
			}
			const auto = autoTheme();
			const override = localStorage.getItem('theme-override');
			if (override) {
				if (localStorage.getItem('theme-override-auto') !== auto) {
					localStorage.removeItem('theme-override');
					localStorage.removeItem('theme-override-auto');
				} else {
					document.documentElement.dataset.theme = override;
					return;
				}
			}
			document.documentElement.dataset.theme = auto;
		};
		apply();
		setInterval(apply, 60000);
	})();
</script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
